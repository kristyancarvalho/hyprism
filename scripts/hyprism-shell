#!/usr/bin/env python3

import argparse
import copy
from datetime import datetime
import importlib.util
import json
import os
from pathlib import Path
import select
import shutil
import subprocess
import sys
import tempfile
import termios
import tty
import urllib.parse
import urllib.request


SUPPORTED_LANGUAGES = ("en", "pt-BR")
WIDGETS = ("clock", "weather", "media", "system", "network", "storage", "sensors", "uptime", "services", "tasks", "processes")
PANELS = {
    "hub": "openHub",
    "launcher": "toggleLauncher",
    "clipboard": "toggleClipboard",
    "wallpapers": "toggleWallpaperPicker",
    "network": "toggleNetwork",
    "bluetooth": "toggleBluetooth",
    "power": "togglePowerMenu",
    "emoji": "toggleEmojiPicker",
    "recording": "toggleRecording",
}
THEME_MODES = ("dark", "light")


def keyboard_backend():
    path = root_dir() / "scripts/system/keyboard_backend.py"
    specification = importlib.util.spec_from_file_location("hyprism_keyboard_backend", path)
    if not specification or not specification.loader:
        raise SystemExit(f"Keyboard backend could not be loaded: {path}")
    module = importlib.util.module_from_spec(specification)
    specification.loader.exec_module(module)
    return module


def translations():
    locale = "en"
    try:
        locale = configuration().get("language", "en")
    except SystemExit:
        pass
    directory = root_dir() / "config/quickshell/i18n"
    with (directory / "en.json").open(encoding="utf-8") as source:
        english = json.load(source)
    if locale == "en":
        return english
    try:
        with (directory / f"{locale}.json").open(encoding="utf-8") as source:
            selected = json.load(source)
    except (OSError, json.JSONDecodeError):
        return english
    return {**english, **selected}


def tr(catalog, key, **values):
    value = catalog
    for part in key.split("."):
        value = value.get(part) if isinstance(value, dict) else None
        if value is None:
            value = key
            break
    return value.format(**values)


def root_dir():
    configured = os.environ.get("HYPRISM_ROOT")
    if configured:
        return Path(configured).expanduser()
    installed = Path.home() / ".local/share/hyprism"
    if installed.is_dir():
        return installed
    system = Path("/usr/share/hyprism")
    if system.is_dir():
        return system
    source = Path(__file__).resolve().parent.parent
    if (source / "config/user.json").is_file():
        return source
    raise SystemExit("Hyprism runtime resources were not found")


def config_path():
    configured = os.environ.get("HYPRISM_CONFIG")
    return Path(configured).expanduser() if configured else Path.home() / ".config/hyprism/user.json"


def default_config():
    with (root_dir() / "config/user.json").open(encoding="utf-8") as source:
        return json.load(source)


def read_json(path, required=True):
    try:
        with path.open(encoding="utf-8") as source:
            value = json.load(source)
    except FileNotFoundError:
        if required:
            raise SystemExit(f"Configuration not found: {path}")
        return None
    except (OSError, json.JSONDecodeError) as error:
        raise SystemExit(f"Invalid configuration {path}: {error}")
    if not isinstance(value, dict):
        raise SystemExit(f"Invalid configuration root in {path}")
    return value


def merge_defaults(defaults, current):
    if not isinstance(defaults, dict) or not isinstance(current, dict):
        return current
    merged = {}
    for key, value in defaults.items():
        merged[key] = merge_defaults(value, current[key]) if key in current else value
    for key, value in current.items():
        if key not in merged:
            merged[key] = value
    return merged


def write_config(value, destination=None):
    destination = destination or config_path()
    if destination.is_symlink():
        destination = destination.resolve()
    destination.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{destination.name}.", dir=destination.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            json.dump(value, output, ensure_ascii=False, indent=2)
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, destination)
        directory = os.open(destination.parent, os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        temporary.unlink(missing_ok=True)


def configuration():
    return read_json(config_path())


def invoke(arguments, replace=False):
    try:
        if replace:
            os.execvp(arguments[0], arguments)
        return subprocess.run(arguments, check=False).returncode
    except FileNotFoundError:
        raise SystemExit(f"Required command not found: {arguments[0]}")


def internal(relative, *arguments, replace=False):
    return invoke([str(root_dir() / relative), *arguments], replace=replace)


def ipc(*arguments):
    subprocess.run(
        [str(root_dir() / "scripts/system/shell-ipc"), *arguments],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )


def widget_config(config, name):
    return config.setdefault("shell", {}).setdefault("widgets", {}).setdefault(name, {})


def widget_enabled(config, name):
    value = config.get("shell", {}).get("widgets", {}).get(name, {})
    if isinstance(value, bool):
        return value
    return value.get("enabled", True) if isinstance(value, dict) else True


def widgets_command(args):
    config = configuration()
    if args.widget_command == "list":
        for name in WIDGETS:
            print(f"{name}\t{'enabled' if widget_enabled(config, name) else 'disabled'}")
        return 0
    names = WIDGETS if args.all else (args.widget,)
    for name in names:
        current = widget_enabled(config, name)
        enabled = not current if args.widget_command == "toggle" else args.widget_command == "enable"
        value = config.setdefault("shell", {}).setdefault("widgets", {}).get(name)
        if isinstance(value, bool):
            config["shell"]["widgets"][name] = {"enabled": enabled}
        else:
            widget_config(config, name)["enabled"] = enabled
    write_config(config)
    for name in names:
        print(f"{name}\t{'enabled' if widget_enabled(config, name) else 'disabled'}")
    return 0


def language_command(args):
    config = configuration()
    if args.language_command is None:
        print(config.get("language", "en"))
        return 0
    config["language"] = args.locale
    write_config(config)
    print(args.locale)
    return 0


def appearance(config):
    value = config.setdefault("appearance", {})
    if value.get("mode") not in THEME_MODES:
        value["mode"] = "dark"
    legacy_warm_white = value.get("warmWhite") is True
    temperature = value.get("whiteTemperature", 2 if legacy_warm_white else 0)
    if isinstance(temperature, bool) or not isinstance(temperature, int) or temperature not in range(4):
        temperature = 0
    value["whiteTemperature"] = temperature
    schedule = value.setdefault("schedule", {})
    schedule.setdefault("enabled", False)
    schedule.setdefault("lightStart", "07:00")
    schedule.setdefault("darkStart", "18:00")
    return value


def parse_time(value):
    try:
        parsed = datetime.strptime(value, "%H:%M")
    except ValueError:
        raise argparse.ArgumentTypeError("time must use 24-hour HH:MM format")
    return parsed.strftime("%H:%M")


def scheduled_mode(schedule, now=None):
    current = now or datetime.now()
    minute = current.hour * 60 + current.minute
    light_hour, light_minute = map(int, schedule["lightStart"].split(":"))
    dark_hour, dark_minute = map(int, schedule["darkStart"].split(":"))
    light = light_hour * 60 + light_minute
    dark = dark_hour * 60 + dark_minute
    if light == dark:
        raise SystemExit("Light and dark start times must differ")
    active = light <= minute < dark if light < dark else minute >= light or minute < dark
    return "light" if active else "dark"


def regenerate_theme():
    result = subprocess.run(
        [str(root_dir() / "scripts/wallpaper"), "theme"],
        text=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        detail = result.stderr.strip()
        raise SystemExit(detail or "Theme generation failed")


def set_theme_mode(config, mode, disable_schedule):
    settings = appearance(config)
    changed = settings["mode"] != mode
    schedule_changed = disable_schedule and settings["schedule"]["enabled"]
    settings["mode"] = mode
    if disable_schedule:
        settings["schedule"]["enabled"] = False
    if changed or schedule_changed:
        write_config(config)
    if changed:
        regenerate_theme()
    return mode


def reconcile_theme(config, now=None):
    settings = appearance(config)
    if not settings["schedule"]["enabled"]:
        return settings["mode"]
    return set_theme_mode(config, scheduled_mode(settings["schedule"], now), False)


def set_white_temperature(config, temperature):
    settings = appearance(config)
    changed = settings["whiteTemperature"] != temperature or "warmWhite" in settings
    settings["whiteTemperature"] = temperature
    settings.pop("warmWhite", None)
    if changed:
        write_config(config)
        if settings["mode"] == "light":
            regenerate_theme()
    return temperature


def theme_command(args):
    config = configuration()
    settings = appearance(config)
    if args.theme_command == "get":
        print(settings["mode"])
        return 0
    if args.theme_command == "set":
        print(set_theme_mode(config, args.mode, True))
        return 0
    if args.theme_command == "toggle":
        print(set_theme_mode(config, "dark" if settings["mode"] == "light" else "light", True))
        return 0
    if args.theme_command == "temperature":
        if args.temperature_command == "get":
            print(settings["whiteTemperature"])
            return 0
        print(set_white_temperature(config, args.level))
        return 0
    schedule = settings["schedule"]
    if args.schedule_command == "get":
        print(f"{'enabled' if schedule['enabled'] else 'disabled'} {schedule['lightStart']} {schedule['darkStart']}")
        return 0
    if args.schedule_command == "set":
        if args.light_start == args.dark_start:
            raise SystemExit("Light and dark start times must differ")
        schedule["lightStart"] = args.light_start
        schedule["darkStart"] = args.dark_start
        if args.enabled is not None:
            schedule["enabled"] = args.enabled
        write_config(config)
        if schedule["enabled"]:
            reconcile_theme(config)
        print(f"{args.light_start} {args.dark_start}")
        return 0
    if args.schedule_command == "enable":
        schedule["enabled"] = True
        write_config(config)
        print(reconcile_theme(config))
        return 0
    schedule["enabled"] = False
    write_config(config)
    print(settings["mode"])
    return 0


def geocode(location):
    query = urllib.parse.urlencode({"name": location, "count": 1, "language": "en", "format": "json"})
    try:
        with urllib.request.urlopen(f"https://geocoding-api.open-meteo.com/v1/search?{query}", timeout=10) as response:
            result = json.load(response)
    except (OSError, ValueError) as error:
        raise SystemExit(f"Could not resolve weather location: {error}")
    entries = result.get("results") or []
    if not entries:
        raise SystemExit(f"Weather location not found: {location}")
    return entries[0]


def weather_command(args):
    config = configuration()
    weather = config.setdefault("weather", {})
    if args.location is None:
        print(weather.get("location", ""))
        return 0
    location = args.location.strip()
    if not location:
        raise SystemExit("Weather location cannot be empty")
    result = geocode(location)
    weather["location"] = result.get("name") or location
    weather["latitude"] = result["latitude"]
    weather["longitude"] = result["longitude"]
    weather["timezone"] = result.get("timezone") or "auto"
    write_config(config)
    ipc("shell", "refreshWeather")
    print(weather["location"])
    return 0


def migrate_command(args):
    defaults = default_config()
    existing = read_json(Path(args.existing), required=False) if args.existing else None
    config = merge_defaults(defaults, existing or {})
    if not existing or "keyboard" not in existing:
        try:
            config["keyboard"] = keyboard_backend().capture_initial_config()
        except keyboard_backend().KeyboardError:
            config["keyboard"] = {"default": None, "devices": {}}
    if existing and "language" not in existing:
        config["language"] = "pt-BR"
    elif not existing:
        config["language"] = args.language
    elif existing.get("language") not in SUPPORTED_LANGUAGES:
        config["language"] = "en"
    existing_appearance = existing.get("appearance", {}) if existing else {}
    if "whiteTemperature" not in existing_appearance and existing_appearance.get("warmWhite") is True:
        config.setdefault("appearance", {})["whiteTemperature"] = 2
    config.setdefault("appearance", {}).pop("warmWhite", None)
    write_config(config)
    keyboard_backend().render_config(config)
    return 0


def create_link(source, destination):
    if destination.is_symlink():
        try:
            if destination.resolve() == source.resolve():
                return "unchanged"
        except OSError:
            pass
        return "preserved"
    if destination.exists():
        return "preserved"
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.symlink_to(source)
    return "created"


def init_command(args):
    root = root_dir()
    destination = config_path()
    existing = read_json(destination, required=False)
    config = merge_defaults(default_config(), existing or {})
    if not existing or "keyboard" not in existing:
        try:
            config["keyboard"] = keyboard_backend().capture_initial_config()
        except keyboard_backend().KeyboardError:
            config["keyboard"] = {"default": None, "devices": {}}
    if existing:
        if existing.get("language") not in SUPPORTED_LANGUAGES:
            config["language"] = "en"
    else:
        config["language"] = args.language
    write_config(config, destination)
    keyboard_backend().render_config(config)

    home = Path.home()
    cache = Path(os.environ.get("XDG_CACHE_HOME", home / ".cache")) / "hyprism/theme"
    xdg_config = Path(os.environ.get("XDG_CONFIG_HOME", home / ".config"))
    links = (
        (root / "config/hypr", xdg_config / "hypr"),
        (root / "config/quickshell", xdg_config / "quickshell/default"),
        (root / "config/quickshell", xdg_config / "quickshell/hyprism"),
        (root / "config/foot/foot.ini", xdg_config / "foot/foot.ini"),
        (root / "config/kitty/kitty.conf", xdg_config / "kitty/kitty.conf"),
        (cache / "fastfetch/config.jsonc", xdg_config / "fastfetch/config.jsonc"),
        (root / "config/fastfetch/images/archlinux.svg", xdg_config / "fastfetch/images/archlinux-source.svg"),
        (cache / "gtk-3.0/settings.ini", xdg_config / "gtk-3.0/settings.ini"),
        (cache / "gtk-4.0/settings.ini", xdg_config / "gtk-4.0/settings.ini"),
        (cache / "gtk-2.0/gtkrc", home / ".gtkrc-2.0"),
        (root / "config/qt5ct/qt5ct.conf", xdg_config / "qt5ct/qt5ct.conf"),
        (root / "config/qt6ct/qt6ct.conf", xdg_config / "qt6ct/qt6ct.conf"),
        (root / "config/Kvantum/kvantum.kvconfig", xdg_config / "Kvantum/kvantum.kvconfig"),
        (root / "config/environment.d/90-hyprism.conf", xdg_config / "environment.d/90-hyprism.conf"),
        (root / "config/systemd/user/hyprism-hyprsunset.service", xdg_config / "systemd/user/hyprism-hyprsunset.service"),
        (cache / "starship.toml", xdg_config / "starship.toml"),
        (cache / "tmux.conf", xdg_config / "tmux/theme.conf"),
        (cache / "zathura/zathurarc", xdg_config / "zathura/zathurarc"),
        (root / "config/applications/hyprism-keyboard-setup.desktop", home / ".local/share/applications/hyprism-keyboard-setup.desktop"),
    )
    created = 0
    preserved = 0
    for source, target in links:
        result = create_link(source, target)
        created += result == "created"
        preserved += result == "preserved"

    wallpaper_dir = Path(config.get("paths", {}).get("wallpapers", "~/Imagens/Wallpapers")).expanduser()
    screenshot_dir = Path(config.get("paths", {}).get("screenshots", "~/Imagens/Screenshots")).expanduser()
    wallpaper_dir.mkdir(parents=True, exist_ok=True)
    screenshot_dir.mkdir(parents=True, exist_ok=True)
    for source in sorted((root / "wallpapers").glob("*.png")):
        target = wallpaper_dir / source.name
        if not target.exists():
            shutil.copyfile(source, target)

    if os.environ.get("HYPRISM_SKIP_SERVICE_ENABLE") != "1" and shutil.which("systemctl"):
        subprocess.run(["systemctl", "--user", "daemon-reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        subprocess.run(["systemctl", "--user", "enable", "hyprpolkitagent.service"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)

    print(f"runtime\t{root}")
    print(f"config\t{destination}")
    print(f"links\t{created} created, {preserved} preserved")
    return 0


class TerminalUI:
    def __init__(self):
        self.input = sys.stdin.fileno()
        self.output = sys.stdout.fileno()
        self.previous = None

    def __enter__(self):
        if not os.isatty(self.input) or not os.isatty(self.output):
            raise SystemExit("Keyboard setup requires an interactive terminal")
        self.previous = termios.tcgetattr(self.input)
        tty.setcbreak(self.input)
        os.write(self.output, b"\033[?25l")
        return self

    def __exit__(self, kind, value, traceback):
        if self.previous is not None:
            termios.tcsetattr(self.input, termios.TCSADRAIN, self.previous)
        os.write(self.output, b"\033[?25h\033[0m\n")

    def draw(self, lines):
        content = "\033[2J\033[H" + "\n".join(lines)
        os.write(self.output, content.encode("utf-8", errors="replace"))

    def key(self):
        value = os.read(self.input, 1)
        if value == b"\x1b":
            ready, _, _ = select.select([self.input], [], [], 0.035)
            if not ready:
                return "escape"
            sequence = os.read(self.input, 2)
            return {b"[A": "up", b"[B": "down", b"[C": "right", b"[D": "left"}.get(sequence, "escape")
        if value in (b"\r", b"\n"):
            return "enter"
        if value == b"\x03":
            raise KeyboardInterrupt
        if value and value[0] >= 0xC0:
            length = 1
            if value[0] & 0xF0 == 0xE0:
                length = 2
            elif value[0] & 0xF8 == 0xF0:
                length = 3
            value += os.read(self.input, length)
        return value.decode("utf-8", errors="ignore")

    def choose(self, title, entries, footer, selected=0):
        while True:
            lines = [title, ""]
            height = shutil.get_terminal_size((80, 24)).lines
            available = max(4, height - len(title.splitlines()) - 4)
            start = selected
            used = len(entries[selected]) + 1
            while start > 0 and used + len(entries[start - 1]) + 1 <= available:
                start -= 1
                used += len(entries[start]) + 1
            end = selected + 1
            while end < len(entries) and used + len(entries[end]) + 1 <= available:
                used += len(entries[end]) + 1
                end += 1
            if start > 0:
                lines.append("  ↑ …")
            for index in range(start, end):
                entry = entries[index]
                prefix = "›" if index == selected else " "
                lines.append(f"{prefix} {entry[0]}")
                lines.extend(f"  {line}" for line in entry[1:])
                lines.append("")
            if end < len(entries):
                lines.append("  ↓ …")
            lines.append(footer)
            self.draw(lines)
            key = self.key()
            if key in ("up", "left"):
                selected = max(0, selected - 1)
            elif key in ("down", "right"):
                selected = min(len(entries) - 1, selected + 1)
            elif key == "enter":
                return selected
            elif key == "escape":
                return None

    def preview(self, lines):
        self.draw(lines)
        os.write(self.output, b"\033[?25h")
        try:
            while True:
                key = self.key()
                if key in ("enter", "escape"):
                    return key
                if key in ("up", "down", "left", "right"):
                    continue
                if key in ("\x7f", "\b"):
                    os.write(self.output, b"\b \b")
                elif key and key.isprintable():
                    os.write(self.output, key.encode("utf-8"))
        finally:
            os.write(self.output, b"\033[?25l")


def keyboard_label(catalog, item):
    classification = {
        "internal": tr(catalog, "keyboard.builtIn"),
        "external": tr(catalog, "keyboard.external"),
        "keyboard": tr(catalog, "keyboard.device"),
    }[item["classification"]]
    current = item.get("keymap") or format_layout(item)
    return (classification, item["name"], tr(catalog, "keyboard.current", value=current))


def format_layout(value):
    if not value:
        return "—"
    layout = value.get("layout", "")
    variant = value.get("variant", "")
    return f"{layout} / {variant}" if variant else layout


def preset_entries(catalog, backend, include_more=True):
    names = {
        "system": "keyboard.preset.system",
        "us": "keyboard.preset.us",
        "us-intl": "keyboard.preset.usIntl",
        "br-abnt2": "keyboard.preset.brAbnt2",
        "pt": "keyboard.preset.portuguese",
        "es": "keyboard.preset.spanish",
        "de": "keyboard.preset.german",
        "fr": "keyboard.preset.french",
    }
    entries = [(name, tr(catalog, key)) for name, key in names.items()]
    if include_more:
        entries.append(("more", tr(catalog, "keyboard.moreLayouts")))
    return entries


def persist_keyboard(config, backend, targets, value, system_selection=False):
    original = copy.deepcopy(config)
    keyboard = config.setdefault("keyboard", {"default": None, "devices": {}})
    devices = keyboard.setdefault("devices", {})
    for target in targets:
        if system_selection:
            devices.pop(target, None)
        else:
            devices[target] = {"layout": value["layout"], "variant": value.get("variant", "")}
    try:
        write_config(config)
        backend.render_config(config)
    except Exception:
        config.clear()
        config.update(original)
        write_config(original)
        backend.render_config(original)
        raise


def persist_keyboard_default(config, backend, value, system_selection=False):
    original = copy.deepcopy(config)
    keyboard = config.setdefault("keyboard", {"default": None, "devices": {}})
    keyboard["default"] = None if system_selection else value
    try:
        write_config(config)
        backend.render_config(config)
    except Exception:
        config.clear()
        config.update(original)
        write_config(original)
        backend.render_config(original)
        raise


def keyboard_setup(args):
    backend = keyboard_backend()
    catalog = translations()
    try:
        devices = backend.discover_devices()
    except backend.KeyboardError as error:
        raise SystemExit(str(error))
    if not devices:
        raise SystemExit(tr(catalog, "keyboard.noDevices"))
    config = configuration()
    footer = tr(catalog, "keyboard.navigation")
    with TerminalUI() as terminal:
        while True:
            entries = [keyboard_label(catalog, item) for item in devices]
            selected = terminal.choose(
                tr(catalog, "keyboard.setupTitle") + "\n" + tr(catalog, "keyboard.detectedCount", count=len(devices)),
                entries,
                footer,
            )
            if selected is None:
                return 0
            device = devices[selected]
            presets = preset_entries(catalog, backend)
            preset_index = terminal.choose(
                tr(catalog, "keyboard.configure", name=device["name"]),
                [(label,) for _, label in presets],
                footer,
            )
            if preset_index is None:
                continue
            preset, label = presets[preset_index]
            if preset == "more":
                layouts = backend.installed_layouts()
                if not layouts:
                    terminal.draw([tr(catalog, "keyboard.noLayouts"), "", tr(catalog, "keyboard.enterBack")])
                    while terminal.key() not in ("enter", "escape"):
                        pass
                    continue
                layout_index = terminal.choose(
                    tr(catalog, "keyboard.moreLayouts"),
                    [(item["name"], item["layout"]) for item in layouts],
                    footer,
                )
                if layout_index is None:
                    continue
                selected_layout = layouts[layout_index]
                preset = selected_layout["preset"]
                label = selected_layout["name"]
            applied = []
            previous = {}
            try:
                candidate = backend.preset_value(preset)
                previous = {item["id"]: {"layout": item["layout"], "variant": item["variant"]} for item in device["interfaces"]}
                for identifier in device["ids"]:
                    backend.apply_device(identifier, candidate)
                    applied.append(identifier)
            except backend.KeyboardError as error:
                for identifier in applied:
                    try:
                        backend.apply_device(identifier, previous[identifier])
                    except backend.KeyboardError:
                        pass
                terminal.draw([tr(catalog, "keyboard.applyFailed"), "", str(error), "", tr(catalog, "keyboard.enterBack")])
                while terminal.key() not in ("enter", "escape"):
                    pass
                continue
            confirmed = False
            try:
                key = terminal.preview([
                    tr(catalog, "keyboard.previewApplied", preset=label),
                    "",
                    tr(catalog, "keyboard.testPrompt"),
                    "",
                    tr(catalog, "keyboard.previewActions"),
                    "",
                    "> ",
                ])
                if key == "enter":
                    persist_keyboard(config, backend, device["ids"], candidate, preset == "system")
                    confirmed = True
                    device["layout"] = candidate["layout"]
                    device["variant"] = candidate.get("variant", "")
                    device["keymap"] = label
            finally:
                if not confirmed:
                    for identifier in device["ids"]:
                        try:
                            backend.apply_device(identifier, previous[identifier])
                        except backend.KeyboardError:
                            pass


def keyboard_devices(args):
    backend = keyboard_backend()
    try:
        devices = backend.discover_devices(include_auxiliary=args.all)
    except backend.KeyboardError as error:
        raise SystemExit(str(error))
    config = configuration()
    values = []
    for device in devices:
        effective, source = backend.effective_value(config, device)
        values.append({**device, "effective": effective, "source": source})
    if args.json:
        print(json.dumps(values, ensure_ascii=False, indent=2))
        return 0
    for item in values:
        print(f"{item['classification']}\t{item['id']}")
        print(f"  name\t{item['name']}")
        print(f"  runtime\t{format_layout(item)}")
        print(f"  effective\t{format_layout(item['effective'])}")
        print(f"  source\t{item['source']}")
    return 0


def keyboard_get(args):
    backend = keyboard_backend()
    config = configuration()
    keyboard = config.get("keyboard", {})
    default = keyboard.get("default")
    system = backend.system_layout()
    print(f"system\t{format_layout(system)}")
    print(f"default\t{format_layout(default) if default else 'system'}")
    for name, value in sorted(keyboard.get("devices", {}).items()):
        print(f"device\t{name}\t{format_layout(value)}")
    return 0


def keyboard_set(args):
    backend = keyboard_backend()
    config = configuration()
    try:
        value = backend.preset_value(args.preset, args.variant)
        devices = backend.discover_devices(include_auxiliary=True) if args.target != "default" else []
        try:
            targets = backend.targets_for(devices, args.target)
        except backend.KeyboardError:
            configured = config.get("keyboard", {}).get("devices", {})
            if args.preset == "system" and args.target in configured:
                targets = [args.target]
            else:
                raise
        if args.target == "default":
            current_default = config.get("keyboard", {}).get("default") or backend.system_layout()
            backend.apply_default(value)
            try:
                persist_keyboard_default(config, backend, value, args.preset == "system")
            except Exception:
                if current_default:
                    try:
                        backend.apply_default(current_default)
                    except backend.KeyboardError:
                        pass
                raise
        else:
            if not targets:
                raise backend.KeyboardError(f"No keyboards matched target: {args.target}")
            previous = {
                interface["id"]: {"layout": interface["layout"], "variant": interface["variant"]}
                for item in devices for interface in item["interfaces"] if interface["id"] in targets
            }
            applied = []
            try:
                for target in targets:
                    if target in previous:
                        backend.apply_device(target, value)
                        applied.append(target)
                persist_keyboard(config, backend, targets, value, args.preset == "system")
            except Exception:
                for target in applied:
                    try:
                        backend.apply_device(target, previous[target])
                    except backend.KeyboardError:
                        pass
                raise
    except backend.KeyboardError as error:
        raise SystemExit(str(error))
    print(format_layout(value))
    return 0


def keyboard_command(args):
    if args.keyboard_command == "setup":
        return keyboard_setup(args)
    if args.keyboard_command == "devices":
        return keyboard_devices(args)
    if args.keyboard_command == "get":
        return keyboard_get(args)
    return keyboard_set(args)


def add_widget_target(parser):
    target = parser.add_mutually_exclusive_group(required=True)
    target.add_argument("widget", nargs="?", choices=WIDGETS)
    target.add_argument("--all", action="store_true")


def parser():
    result = argparse.ArgumentParser(prog="hyprism-shell", description="Configure and control Hyprism")
    commands = result.add_subparsers(dest="command", required=True)

    initialize = commands.add_parser("init", help="initialize user configuration for a packaged installation")
    initialize.add_argument("--lang", choices=SUPPORTED_LANGUAGES, default="en", dest="language")

    widgets = commands.add_parser("widgets", help="manage desktop widgets")
    widget_commands = widgets.add_subparsers(dest="widget_command", required=True)
    widget_commands.add_parser("list", help="list widget state")
    for action in ("enable", "disable", "toggle"):
        add_widget_target(widget_commands.add_parser(action, help=f"{action} desktop widgets"))

    weather = commands.add_parser("weather", help="manage weather settings")
    weather_commands = weather.add_subparsers(dest="weather_command", required=True)
    location = weather_commands.add_parser("location", help="get or set the weather location")
    location.add_argument("location", nargs="?")

    language = commands.add_parser("language", help="get or set the interface language")
    language_commands = language.add_subparsers(dest="language_command")
    language_set = language_commands.add_parser("set", help="set the interface language")
    language_set.add_argument("locale", choices=SUPPORTED_LANGUAGES)

    theme = commands.add_parser("theme", help="manage light and dark appearance")
    theme_commands = theme.add_subparsers(dest="theme_command", required=True)
    theme_commands.add_parser("get", help="print the active appearance")
    theme_set = theme_commands.add_parser("set", help="set the appearance and disable scheduling")
    theme_set.add_argument("mode", choices=THEME_MODES)
    theme_commands.add_parser("toggle", help="toggle the appearance and disable scheduling")
    temperature = theme_commands.add_parser("temperature", help="manage the light palette temperature")
    temperature_commands = temperature.add_subparsers(dest="temperature_command", required=True)
    temperature_commands.add_parser("get", help="print the temperature level")
    temperature_set = temperature_commands.add_parser("set", help="set the temperature level")
    temperature_set.add_argument("level", type=int, choices=range(4))
    schedule = theme_commands.add_parser("schedule", help="manage automatic appearance switching")
    schedule_commands = schedule.add_subparsers(dest="schedule_command", required=True)
    schedule_commands.add_parser("get", help="print schedule state and boundaries")
    schedule_set = schedule_commands.add_parser("set", help="set light and dark start times")
    schedule_set.add_argument("light_start", type=parse_time)
    schedule_set.add_argument("dark_start", type=parse_time)
    schedule_state = schedule_set.add_mutually_exclusive_group()
    schedule_state.add_argument("--enable", action="store_const", const=True, dest="enabled")
    schedule_state.add_argument("--disable", action="store_const", const=False, dest="enabled")
    schedule_commands.add_parser("enable", help="enable and apply the schedule")
    schedule_commands.add_parser("disable", help="disable the schedule")

    keyboard = commands.add_parser("keyboard", help="inspect and configure keyboards")
    keyboard_commands = keyboard.add_subparsers(dest="keyboard_command", required=True)
    keyboard_commands.add_parser("setup", help="open the arrow-key keyboard setup")
    keyboard_devices_parser = keyboard_commands.add_parser("devices", help="list detected keyboards")
    keyboard_devices_parser.add_argument("--json", action="store_true", help="print structured JSON")
    keyboard_devices_parser.add_argument("--all", action="store_true", help="include auxiliary HID keyboard interfaces")
    keyboard_commands.add_parser("get", help="print system defaults and Hyprism overrides")
    keyboard_set_parser = keyboard_commands.add_parser("set", help="set a keyboard preset")
    keyboard_set_parser.add_argument("target", help="device ID, default, built-in, external, or all")
    keyboard_set_parser.add_argument("preset", help="system, common preset, or xkb:LAYOUT")
    keyboard_set_parser.add_argument("--variant", default=None, help="XKB variant for xkb:LAYOUT")

    wallpaper = commands.add_parser("wallpaper", help="manage wallpapers")
    wallpaper_commands = wallpaper.add_subparsers(dest="wallpaper_command", required=True)
    for action in ("random", "current", "list"):
        wallpaper_commands.add_parser(action)
    wallpaper_set = wallpaper_commands.add_parser("set")
    wallpaper_set.add_argument("image")

    screenshot = commands.add_parser("screenshot", help="capture the screen")
    screenshot.add_argument("mode", choices=("region", "monitor"))
    commands.add_parser("color", help="pick a screen color")
    commands.add_parser("lock", help="lock the session")
    commands.add_parser("reload", help="reload Quickshell")
    commands.add_parser("recording", help="open the screen recording selector")
    night_mode = commands.add_parser("night-mode", help="set the night mode")
    night_mode.add_argument("state", choices=("on", "off", "toggle"), nargs="?", default="toggle")
    panel = commands.add_parser("open", help="open a shell panel")
    panel.add_argument("panel", choices=tuple(PANELS))

    return result


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "_migrate":
        migrate = argparse.ArgumentParser(add_help=False)
        migrate.add_argument("--language", choices=SUPPORTED_LANGUAGES, default="en")
        migrate.add_argument("--existing")
        return migrate_command(migrate.parse_args(sys.argv[2:]))
    if len(sys.argv) > 1 and sys.argv[1] == "_theme-reconcile":
        reconcile = argparse.ArgumentParser(add_help=False)
        reconcile.add_argument("--now", type=parse_time)
        arguments = reconcile.parse_args(sys.argv[2:])
        now = datetime.strptime(arguments.now, "%H:%M") if arguments.now else None
        print(reconcile_theme(configuration(), now))
        return 0
    args = parser().parse_args()
    if args.command == "init":
        return init_command(args)
    if args.command == "widgets":
        return widgets_command(args)
    if args.command == "weather":
        return weather_command(args)
    if args.command == "language":
        return language_command(args)
    if args.command == "theme":
        return theme_command(args)
    if args.command == "keyboard":
        return keyboard_command(args)
    if args.command == "wallpaper":
        arguments = [args.wallpaper_command]
        if args.wallpaper_command == "set":
            arguments.append(args.image)
        return internal("scripts/wallpaper", *arguments, replace=True)
    if args.command == "screenshot":
        return internal("scripts/system/action", f"screenshot-{'area' if args.mode == 'region' else 'monitor'}", replace=True)
    if args.command == "color":
        return internal("scripts/system/action", "color-picker", replace=True)
    if args.command == "lock":
        return internal("scripts/system/lock", replace=True)
    if args.command == "reload":
        return internal("scripts/system/reload-shell", replace=True)
    if args.command == "night-mode":
        return internal("scripts/system/action", "night-mode", args.state, replace=True)
    if args.command == "recording":
        return internal("scripts/system/shell-ipc", "shell", "toggleRecording", replace=True)
    if args.command == "open":
        return internal("scripts/system/shell-ipc", "shell", PANELS[args.panel], replace=True)
    return 2


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
    except OSError as error:
        raise SystemExit(str(error))
