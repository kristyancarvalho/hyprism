#!/usr/bin/env bash
set -Eeuo pipefail

root_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cache_dir="${HYPRISM_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/hyprism}"
state_dir="$cache_dir/state"
wallpaper_dir="${HYPRISM_WALLPAPER_DIR:-$HOME/Imagens/Wallpapers}"
current_file="$state_dir/current-wallpaper"
lock_wallpaper="$state_dir/lock-wallpaper"
mkdir -p "$state_dir" "$wallpaper_dir"

supported() { [[ $1 =~ \.(png|jpe?g|webp)$ ]]; }
current() { [[ -s $current_file ]] && cat "$current_file"; }
list() {
  find -P "$wallpaper_dir" -maxdepth 1 -type f -print0 2>/dev/null | while IFS= read -r -d '' file; do
    supported "$file" && printf '%s\n' "$file"
  done | sort
}
apply_kitty_colors() {
  command -v kitten >/dev/null || return 0
  local socket runtime_dir
  local applied=0
  local sockets=()
  runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
  shopt -s nullglob
  sockets=("$runtime_dir"/kitty-*)
  shopt -u nullglob
  for socket in "${sockets[@]}"; do
    [[ -S $socket ]] || continue
    if kitten @ --to "unix:$socket" set-colors --all --configured "$cache_dir/theme/kitty.conf" >/dev/null 2>&1; then
      applied=1
    fi
  done
  if ((!applied)) && [[ -n ${KITTY_LISTEN_ON:-} ]]; then
    kitten @ set-colors --all --configured "$cache_dir/theme/kitty.conf" >/dev/null 2>&1 || true
  fi
}
refresh_hyprpolkitagent() {
  command -v systemctl >/dev/null && command -v hyprctl >/dev/null && command -v jq >/dev/null || return 0
  systemctl --user is-active --quiet hyprpolkitagent.service || return 0
  if hyprctl clients -j 2>/dev/null | jq -e 'any(.[]; .class == "hyprpolkitagent")' >/dev/null 2>&1; then
    return 0
  fi
  systemctl --user try-restart hyprpolkitagent.service >/dev/null 2>&1 || true
}
propagate() {
  local image=${1:?caminho do papel de parede obrigatório}
  HYPRISM_CACHE_DIR="$cache_dir" "$root_dir/scripts/theme/generate-theme.py" "$image"
  refresh_hyprpolkitagent
  apply_kitty_colors
  hyprctl reload >/dev/null 2>&1 || true
  command -v qs >/dev/null && "$root_dir/scripts/system/shell-ipc" shell themeChanged "$image" >/dev/null 2>&1 || true
}
apply() {
  local image state_candidate link_candidate
  image=$(realpath -e -- "${1:?caminho do papel de parede obrigatório}")
  [[ -r $image ]] || { printf 'Papel de parede ilegível: %s\n' "$image" >&2; return 1; }
  if command -v awww >/dev/null && [[ -n ${WAYLAND_DISPLAY:-} ]]; then
    awww query >/dev/null 2>&1 || (awww-daemon >/dev/null 2>&1 &)
    for _ in {1..20}; do awww query >/dev/null 2>&1 && break; sleep .1; done
    awww img "$image" --transition-type grow --transition-duration .55 || true
  fi
  propagate "$image"
  state_candidate=$(mktemp "$state_dir/.current-wallpaper.XXXXXX")
  printf '%s\n' "$image" >"$state_candidate"
  mv -f -- "$state_candidate" "$current_file"
  link_candidate="$state_dir/.lock-wallpaper.$$"
  ln -s -- "$image" "$link_candidate"
  mv -Tf -- "$link_candidate" "$lock_wallpaper"
}
random() {
  mapfile -t files < <(list)
  ((${#files[@]})) || { printf 'Nenhum papel de parede compatível em %s\n' "$wallpaper_dir" >&2; return 1; }
  local active chosen candidates=()
  active=$(current || true)
  for file in "${files[@]}"; do [[ $file != "$active" ]] && candidates+=("$file"); done
  ((${#candidates[@]})) || candidates=("${files[@]}")
  chosen=${candidates[RANDOM % ${#candidates[@]}]}
  apply "$chosen"
}
case "${1:-}" in
  set) apply "${2:?uso: wallpaper set IMAGEM}" ;;
  random) random ;;
  current) current ;;
  list) list ;;
  restore) [[ -s $current_file ]] && apply "$(current)" || random ;;
  theme) [[ -s $current_file ]] && propagate "$(current)" || { printf 'Nenhum papel de parede ativo.\n' >&2; exit 1; } ;;
  *) printf 'Uso: %s {set IMAGEM|random|current|list|restore|theme}\n' "$0" >&2; exit 2 ;;
esac
