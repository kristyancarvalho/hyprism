#!/usr/bin/env bash
set -Eeuo pipefail

root_dir="${HYPRISM_ROOT:-$HOME/.local/share/hyprism}"
config_name="${QS_CONFIG_NAME:-default}"
config_path="${HYPRISM_QS_PATH:-}"
development=0
if [[ ${1:-} == --development ]]; then
  development=1
  config_path="${config_path:-$root_dir/config/quickshell/shell.qml}"
fi
selector=(-c "$config_name")
entrypoint="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/$config_name/shell.qml"
if [[ -n $config_path ]]; then
  selector=(-p "$config_path")
  [[ -d $config_path ]] && entrypoint="$config_path/shell.qml" || entrypoint="$config_path"
fi
log_dir="${XDG_CACHE_HOME:-$HOME/.cache}/hyprism"
log_file="$log_dir/quickshell-startup.log"

command -v qs >/dev/null 2>&1 || {
  printf 'Quickshell não está instalado: comando qs não encontrado.\n' >&2
  exit 127
}
[[ -r $entrypoint ]] || {
  printf 'Configuração do Quickshell não encontrada: %s\n' "$entrypoint" >&2
  exit 1
}

mkdir -p "$log_dir"
export HYPRISM_ROOT="$root_dir"
if [[ $(locale charmap 2>/dev/null || true) != UTF-8 ]]; then
  utf8_locale="$(locale -a 2>/dev/null | awk 'BEGIN { IGNORECASE=1 } /^C\.UTF-?8$|^C\.utf8$|^en_US\.UTF-?8$/ { print; exit }')"
  [[ -n $utf8_locale ]] || {
    printf 'Nenhum locale UTF-8 está disponível para iniciar o Quickshell.\n' >&2
    exit 1
  }
  export LC_ALL="$utf8_locale"
fi
if ((development)); then
  export HYPRISM_QS_PATH="$config_path"
  exec qs "${selector[@]}" --no-duplicate
fi
exec qs "${selector[@]}" --no-duplicate >>"$log_file" 2>&1
