#!/usr/bin/env bash
set -Eeuo pipefail
direction=${1:?direction is required}
case "$direction" in
  l) long_direction=left ;;
  r) long_direction=right ;;
  *) printf 'Direction must be l or r.\n' >&2; exit 2 ;;
esac
layout=$(hyprctl -j getoption general.layout 2>/dev/null | jq -r '.str // empty')
if [[ $layout == scrolling ]] && [[ $direction == l || $direction == r ]]; then
  hyprctl dispatch "hl.dsp.layout(\"swapcol $direction\")" 2>/dev/null \
    || hyprctl dispatch "hl.dsp.window.move({ direction = \"$long_direction\" })"
else
  hyprctl dispatch "hl.dsp.window.move({ direction = \"$long_direction\" })"
fi
