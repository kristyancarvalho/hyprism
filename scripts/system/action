#!/usr/bin/env bash
set -Eeuo pipefail

root_dir="${HYPRISM_ROOT:-$HOME/.local/share/hyprism}"
notify() { command -v qs >/dev/null && "$root_dir/scripts/system/shell-ipc" osd "$1" "${2:-}" >/dev/null 2>&1 || true; }
volume() {
  wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ "$1"
  local value; value=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf "%d", $2 * 100}')
  notify volume "$value"
}
brightness() {
  command -v brightnessctl >/dev/null || return 1
  brightnessctl set "$1" >/dev/null
  local value; value=$(brightnessctl -m 2>/dev/null | awk -F, '{gsub("%", "", $4); print $4}')
  notify brightness "${value:-0}"
}
screenshot_area() {
  local dir="$HOME/Imagens/Screenshots" file
  mkdir -p "$dir"; file="$dir/$(date +%Y%m%d_%H%M%S)_area.png"
  grim -g "$(slurp)" "$file" && wl-copy <"$file" && notify screenshot "$file"
}
screenshot_monitor() {
  local dir="$HOME/Imagens/Screenshots" file monitor
  mkdir -p "$dir"; file="$dir/$(date +%Y%m%d_%H%M%S)_monitor.png"
  monitor=$(hyprctl -j monitors | jq -r '.[] | select(.focused) | .name' | head -n1)
  grim -o "$monitor" "$file" && wl-copy <"$file" && notify screenshot "$file"
}
clipboard_watch() {
  wl-paste --type text --watch cliphist store &
  wl-paste --type image --watch cliphist store &
}
case "${1:-}" in
  volume-up) volume 5%+ ;;
  volume-down) volume 5%- ;;
  volume-mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; notify volume "mudo" ;;
  mic-mute) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle; notify microphone "mudo" ;;
  brightness-up) brightness 5%+ ;;
  brightness-down) brightness 5%- ;;
  screenshot-area) screenshot_area ;;
  screenshot-monitor) screenshot_monitor ;;
  color-picker)
    color=$(hyprpicker -a 2>/dev/null || true)
    [[ -n $color ]] && printf '%s' "$color" | wl-copy && notify color "$color"
    ;;
  clipboard-watch) clipboard_watch ;;
  night-mode)
    night_state="${XDG_CACHE_HOME:-$HOME/.cache}/hyprism/state/night-mode"
    mkdir -p "$(dirname "$night_state")"
    mode=${2:-toggle}
    if [[ $mode == toggle ]]; then [[ $(cat "$night_state" 2>/dev/null || true) == on ]] && mode=off || mode=on; fi
    if [[ $mode == on ]]; then hyprctl hyprsunset temperature 4000 >/dev/null 2>&1 && printf on >"$night_state" && notify night Ativado
    else hyprctl hyprsunset identity >/dev/null 2>&1 && printf off >"$night_state" && notify night Desativado
    fi
    ;;
  power-save)
    profile=${2:-power-saver}
    powerprofilesctl set "$profile" >/dev/null 2>&1
    notify power "$([[ $profile == power-saver ]] && printf 'Economia' || printf 'Equilibrado')"
    ;;
  record) ${HYPRISM_RECORD_COMMAND:-wf-recorder -f "$HOME/Imagens/Screenshots/$(date +%Y%m%d_%H%M%S)_recording.mp4"} ;;
  *) printf 'Uso: %s {volume-up|volume-down|volume-mute|mic-mute|brightness-up|brightness-down|screenshot-area|screenshot-monitor|color-picker|clipboard-watch|night-mode|power-save|record}\n' "$0" >&2; exit 2 ;;
esac
