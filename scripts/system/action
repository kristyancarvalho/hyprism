#!/usr/bin/env bash
set -Eeuo pipefail

root_dir="${HYPRISM_ROOT:-$HOME/.local/share/hyprism}"
notify() { command -v qs >/dev/null && "$root_dir/scripts/system/shell-ipc" osd "$1" "${2:-}" >/dev/null 2>&1 || true; }
volume() {
  wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ "$1"
  local value; value=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf "%d", $2 * 100}')
  notify volume "$value"
}
brightness() {
  command -v brightnessctl >/dev/null || return 1
  brightnessctl -c backlight set "$1" >/dev/null
  local value state_dir state_file state_candidate
  value=$(brightnessctl -c backlight -m 2>/dev/null | awk -F, '{gsub("%", "", $4); print $4}')
  state_dir="${XDG_CACHE_HOME:-$HOME/.cache}/hyprism/state"
  state_file="$state_dir/brightness-target"
  mkdir -p -m 0700 "$state_dir"
  state_candidate=$(mktemp "$state_dir/.brightness-target.XXXXXX")
  printf '%s\n' "${value:-0}" >"$state_candidate"
  mv -f -- "$state_candidate" "$state_file"
  if command -v ddcutil >/dev/null 2>&1; then
    "$root_dir/scripts/system/brightness-ddc" >/dev/null 2>&1 &
  fi
  notify brightness "${value:-0}"
}
screenshot_area() {
  local dir="$HOME/Imagens/Screenshots" file
  mkdir -p "$dir"; file="$dir/$(date +%Y%m%d_%H%M%S)_area.png"
  grim -g "$(slurp)" "$file" && wl-copy <"$file" && notify screenshot "$file"
}
screenshot_monitor() {
  local dir="$HOME/Imagens/Screenshots" file monitor
  mkdir -p "$dir"; file="$dir/$(date +%Y%m%d_%H%M%S)_monitor.png"
  monitor=$(hyprctl -j monitors | jq -r '.[] | select(.focused) | .name' | head -n1)
  grim -o "$monitor" "$file" && wl-copy <"$file" && notify screenshot "$file"
}
clipboard_watch() {
  command -v wl-paste >/dev/null || { printf 'wl-paste não está instalado.\n' >&2; return 1; }
  command -v cliphist >/dev/null || { printf 'cliphist não está instalado.\n' >&2; return 1; }
  local runtime_dir lock_file event_file action_path text_pid image_pid
  runtime_dir="${HYPRISM_CLIPBOARD_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}/hyprism-runtime-$UID}/hyprism}"
  lock_file="$runtime_dir/clipboard-watch.lock"
  event_file="${XDG_CACHE_HOME:-$HOME/.cache}/hyprism/state/clipboard-event"
  action_path=$(readlink -f "$0")
  export CLIPHIST_MAX_STORE_SIZE="${CLIPHIST_MAX_STORE_SIZE:-20MiB}"
  mkdir -p -m 0700 "$runtime_dir" "$(dirname "$event_file")"
  exec 8>"$lock_file"
  flock -n 8 || return 0
  printf 'início\n' >"$event_file"
  wl-paste --type text --watch "$action_path" clipboard-store &
  text_pid=$!
  wl-paste --type image --watch "$action_path" clipboard-store &
  image_pid=$!
  trap 'kill "$text_pid" "$image_pid" 2>/dev/null || true; wait "$text_pid" "$image_pid" 2>/dev/null || true' EXIT INT TERM
  wait -n "$text_pid" "$image_pid"
  printf 'Um watcher da área de transferência foi encerrado inesperadamente.\n' >&2
  return 1
}
clipboard_publish_event() {
  local state_dir event_file event_candidate
  state_dir="${XDG_CACHE_HOME:-$HOME/.cache}/hyprism/state"
  event_file="$state_dir/clipboard-event"
  mkdir -p -m 0700 "$state_dir"
  event_candidate=$(mktemp "$state_dir/.clipboard-event.XXXXXX")
  printf '%s\n' "$(date +%s%N)" >"$event_candidate"
  mv -f -- "$event_candidate" "$event_file"
}
clipboard_store() {
  cliphist store
  clipboard_publish_event
}
clipboard_restore() {
  local identifier=${1:-} mime=${2:-}
  [[ $identifier =~ ^[0-9]+$ ]] || { printf 'Identificador inválido da área de transferência.\n' >&2; return 2; }
  [[ $mime =~ ^(text|image)/[A-Za-z0-9.+_-]+(;charset=[A-Za-z0-9._-]+)?$ ]] || { printf 'Tipo MIME inválido da área de transferência.\n' >&2; return 2; }
  cliphist decode "$identifier" | wl-copy --type "$mime"
}
clipboard_delete() {
  local identifier=${1:-}
  [[ $identifier =~ ^[0-9]+$ ]] || { printf 'Identificador inválido da área de transferência.\n' >&2; return 2; }
  printf '%s\n' "$identifier" | cliphist delete
  clipboard_publish_event
}
clipboard_clear() {
  cliphist wipe
  clipboard_publish_event
}
case "${1:-}" in
  volume-up) volume 5%+ ;;
  volume-down) volume 5%- ;;
  volume-mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; notify volume "mudo" ;;
  mic-mute) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle; notify microphone "mudo" ;;
  brightness-up) brightness 5%+ ;;
  brightness-down) brightness 5%- ;;
  brightness-set) brightness "${2:-0}%" ;;
  screenshot-area) screenshot_area ;;
  screenshot-monitor) screenshot_monitor ;;
  color-picker)
    color=$(hyprpicker -a 2>/dev/null || true)
    [[ -n $color ]] && printf '%s' "$color" | wl-copy && notify color "$color"
    ;;
  clipboard-watch) clipboard_watch ;;
  clipboard-store) clipboard_store ;;
  clipboard-restore) clipboard_restore "${2:-}" "${3:-}" ;;
  clipboard-delete) clipboard_delete "${2:-}" ;;
  clipboard-clear) clipboard_clear ;;
  night-mode)
    mode=${2:-toggle}
    if [[ $mode == toggle ]]; then systemctl --user is-active --quiet hyprism-hyprsunset.service && mode=off || mode=on; fi
    if [[ $mode == on ]]; then systemctl --user start hyprism-hyprsunset.service && notify night Ativado
    else systemctl --user stop hyprism-hyprsunset.service && notify night Desativado
    fi
    ;;
  power-save)
    profile=${2:-power-saver}
    powerprofilesctl set "$profile" >/dev/null 2>&1
    notify power "$([[ $profile == power-saver ]] && printf 'Economia' || printf 'Equilibrado')"
    ;;
  *) printf 'Uso: %s {volume-up|volume-down|volume-mute|mic-mute|brightness-up|brightness-down|brightness-set|screenshot-area|screenshot-monitor|color-picker|clipboard-watch|clipboard-store|clipboard-restore|clipboard-delete|clipboard-clear|night-mode|power-save}\n' "$0" >&2; exit 2 ;;
esac
