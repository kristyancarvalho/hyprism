#!/usr/bin/env bash
set -Eeuo pipefail

source_file=${1:?source JSON file is required}
destination=${2:?destination is required}
destination_dir=$(dirname -- "$destination")
mkdir -p "$destination_dir"
temporary=$(mktemp --tmpdir="$destination_dir" .hyprism-json.XXXXXX)
trap 'rm -f -- "$temporary"' EXIT
jq -e . "$source_file" >"$temporary"
chmod 0644 "$temporary"
mv -f -- "$temporary" "$destination"
trap - EXIT
