#!/usr/bin/env bash
set -Eeuo pipefail

mode=${1:-}
output=${2:-}
target=${3:-}
recordings_dir="$HOME/Vídeos/gravacoes"
runtime_dir="${HYPRISM_RECORDING_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}/hyprism-runtime-$UID}/hyprism}"
lock_file="$runtime_dir/recording.lock"
log_dir="${XDG_CACHE_HOME:-$HOME/.cache}/hyprism"

command -v wf-recorder >/dev/null || { printf 'wf-recorder não está instalado.\n' >&2; exit 127; }
command -v flock >/dev/null || { printf 'flock não está disponível.\n' >&2; exit 127; }
mkdir -p -m 0700 "$runtime_dir"
mkdir -p "$recordings_dir" || { printf 'Não foi possível criar a pasta de gravações.\n' >&2; exit 1; }
[[ -w $recordings_dir ]] || { printf 'A pasta de gravações não permite escrita.\n' >&2; exit 1; }
[[ $(dirname -- "$output") == "$recordings_dir" && $(basename -- "$output") =~ ^[0-9]{8}_[0-9]{6}_[0-9]{3}_(tela|regiao)\.mp4$ ]] \
  || { printf 'O caminho de saída da gravação é inválido.\n' >&2; exit 2; }

exec 9>"$lock_file"
flock -n 9 || { printf 'Já existe uma gravação do Hyprism em andamento.\n' >&2; exit 24; }

arguments=(-f "$output" -c libx264)
case "$mode" in
  regiao)
    [[ $target =~ ^-?[0-9]+,-?[0-9]+[[:space:]][0-9]+x[0-9]+$ ]] \
      || { printf 'A geometria selecionada é inválida.\n' >&2; exit 2; }
    arguments+=(-g "$target")
    ;;
  tela)
    command -v hyprctl >/dev/null || { printf 'hyprctl não está disponível.\n' >&2; exit 127; }
    command -v jq >/dev/null || { printf 'jq não está disponível.\n' >&2; exit 127; }
    hyprctl -j monitors | jq -e --arg monitor "$target" '.[] | select(.name == $monitor)' >/dev/null 2>&1 \
      || { printf 'O monitor selecionado não é válido.\n' >&2; exit 2; }
    arguments+=(-o "$target")
    ;;
  *)
    printf 'O modo de gravação é inválido.\n' >&2
    exit 2
    ;;
esac

recorder_error=$(mktemp "$runtime_dir/.wf-recorder.XXXXXX")
wf-recorder "${arguments[@]}" 2>"$recorder_error" &
recorder_pid=$!
forwarded=0
forward_signal() {
  forwarded=1
  kill -INT "$recorder_pid" 2>/dev/null || true
}
trap forward_signal INT TERM HUP
printf 'INICIADA\n'
set +e
while true; do
  wait "$recorder_pid"
  status=$?
  kill -0 "$recorder_pid" 2>/dev/null || break
done
set -e
if ((status == 0)) && [[ -s $output ]]; then
  rm -f "$recorder_error"
  printf 'SALVA:%s\n' "$output"
  exit 0
fi
((status == 0)) && status=1
mkdir -p -m 0700 "$log_dir"
chmod 0600 "$recorder_error"
mv -f "$recorder_error" "$log_dir/recording-error.log"
((forwarded)) && printf 'O gravador não confirmou a finalização do arquivo.\n' >&2
printf 'wf-recorder falhou; consulte %s/recording-error.log.\n' "$log_dir" >&2
exit "$status"
