#!/usr/bin/env bash
set -Eeuo pipefail

mode=${1:-}
output=${2:-}
target=${3:-}
config_file="${HYPRISM_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/hyprism/user.json}"
configured_recordings_dir=$(jq -r '.paths.recordings // empty' "$config_file" 2>/dev/null || true)
configured_recordings_dir=${configured_recordings_dir/#\~/$HOME}
recordings_dir="${HYPRISM_RECORDINGS_DIR:-${configured_recordings_dir:-$HOME/Videos/Recordings}}"
runtime_dir="${HYPRISM_RECORDING_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}/hyprism-runtime-$UID}/hyprism}"
lock_file="$runtime_dir/recording.lock"
log_dir="${XDG_CACHE_HOME:-$HOME/.cache}/hyprism"
selector_pid=
recorder_pid=
forwarded=0

forward_signal() {
  forwarded=1
  [[ -z $selector_pid ]] || kill -TERM "$selector_pid" 2>/dev/null || true
  [[ -z $recorder_pid ]] || kill -INT "$recorder_pid" 2>/dev/null || true
}

trap forward_signal INT TERM HUP

command -v wf-recorder >/dev/null || { printf 'wf-recorder is not installed.\n' >&2; exit 127; }
command -v flock >/dev/null || { printf 'flock is not available.\n' >&2; exit 127; }
mkdir -p -m 0700 "$runtime_dir"
mkdir -p "$recordings_dir" || { printf 'Could not create the recordings directory.\n' >&2; exit 1; }
[[ -w $recordings_dir ]] || { printf 'The recordings directory is not writable.\n' >&2; exit 1; }
[[ $(dirname -- "$output") == "$recordings_dir" && $(basename -- "$output") =~ ^[0-9]{8}_[0-9]{6}_[0-9]{3}_(tela|regiao)\.mp4$ ]] \
  || { printf 'The recording output path is invalid.\n' >&2; exit 2; }

exec 9>"$lock_file"
flock -n 9 || { printf 'A Hyprism recording is already in progress.\n' >&2; exit 24; }

arguments=(-f "$output" -c libx264)
case "$mode" in
  regiao)
    if [[ -z $target ]]; then
      command -v slurp >/dev/null || { printf 'slurp is not installed.\n' >&2; exit 127; }
      selector_output=$(mktemp "$runtime_dir/.slurp-output.XXXXXX")
      selector_error=$(mktemp "$runtime_dir/.slurp-error.XXXXXX")
      slurp -f '%x,%y %wx%h' >"$selector_output" 2>"$selector_error" &
      selector_pid=$!
      set +e
      wait "$selector_pid"
      selector_status=$?
      set -e
      selector_pid=
      if ((forwarded || selector_status == 1 || selector_status == 130 || selector_status == 143)); then
        rm -f "$selector_output" "$selector_error"
        printf 'CANCELED\n'
        exit 0
      fi
      if ((selector_status != 0)); then
        tr -d '\r' <"$selector_error" >&2
        rm -f "$selector_output" "$selector_error"
        exit "$selector_status"
      fi
      target=$(tr -d '\r\n' <"$selector_output")
      rm -f "$selector_output" "$selector_error"
    fi
    [[ $target =~ ^-?[0-9]+,-?[0-9]+[[:space:]][0-9]+x[0-9]+$ ]] \
      || { printf 'The selected geometry is invalid.\n' >&2; exit 2; }
    arguments+=(-g "$target")
    ;;
  tela)
    command -v hyprctl >/dev/null || { printf 'hyprctl is not available.\n' >&2; exit 127; }
    command -v jq >/dev/null || { printf 'jq is not available.\n' >&2; exit 127; }
    hyprctl -j monitors | jq -e --arg monitor "$target" '.[] | select(.name == $monitor)' >/dev/null 2>&1 \
      || { printf 'The selected monitor is invalid.\n' >&2; exit 2; }
    arguments+=(-o "$target")
    ;;
  *)
    printf 'The recording mode is invalid.\n' >&2
    exit 2
    ;;
esac

recorder_error=$(mktemp "$runtime_dir/.wf-recorder.XXXXXX")
wf-recorder "${arguments[@]}" 2>"$recorder_error" &
recorder_pid=$!
printf 'STARTED\n'
set +e
while true; do
  wait "$recorder_pid"
  status=$?
  kill -0 "$recorder_pid" 2>/dev/null || break
done
set -e
if ((status == 0)) && [[ -s $output ]]; then
  rm -f "$recorder_error"
  printf 'SAVED:%s\n' "$output"
  exit 0
fi
((status == 0)) && status=1
mkdir -p -m 0700 "$log_dir"
chmod 0600 "$recorder_error"
mv -f "$recorder_error" "$log_dir/recording-error.log"
((forwarded)) && printf 'The recorder did not confirm that the file was finalized.\n' >&2
printf 'wf-recorder failed; see %s/recording-error.log.\n' "$log_dir" >&2
exit "$status"
