#!/usr/bin/env bash
set -Eeuo pipefail
root_dir="${HYPRISM_ROOT:-$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../.." && pwd)}"
if "$root_dir/scripts/system/shell-ipc" shell reload >/dev/null 2>&1; then
  exit 0
fi
config_name="${QS_CONFIG_NAME:-default}"
config_path="${HYPRISM_QS_PATH:-}"
selector=(-c "$config_name")
if [[ -n $config_path ]]; then
  selector=(-p "$config_path")
fi
mapfile -t instance_pids < <(qs "${selector[@]}" list -j 2>/dev/null | jq -r '.[].pid' 2>/dev/null || true)
for instance_pid in "${instance_pids[@]}"; do
  qs kill --pid "$instance_pid" >/dev/null 2>&1 || true
done
exec "$root_dir/scripts/system/start-shell"
