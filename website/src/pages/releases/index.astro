---
import { ArrowDown, ArrowUpRight, CalendarDays, ChevronDown, GitBranch, Tag } from '@lucide/astro';
import { Marked, Renderer } from 'marked';
import Base from '../../layouts/Base.astro';
import releases from '../../data/releases.json';

const latest = releases[0];
const renderer = new Renderer();
renderer.html = ({ text }) => text.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');
const markdown = new Marked({ gfm: true, renderer });
const notes = await Promise.all(releases.map(async (release) => ({ release, html: await markdown.parse(release.body) })));
const releaseDate = (value: string) => new Intl.DateTimeFormat('en', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(value));
---
<Base title="Release notes" active="releases" description="Published Hyprism release notes and source tags, ordered by their original publication dates.">
  <section class="release-page">
    <header class="release-intro">
      <p class="eyebrow"><Tag size={15} aria-hidden="true" /> Project archive <span class="intro-rule"></span> {releases.length} releases</p>
      <h1>Release notes</h1>
      <p>Published changes to Hyprism, in release order. Each entry uses the original GitHub release notes and points back to its source.</p>
      <a class="latest-link" href={`#${latest.tag}`}><span>Latest release</span><strong>{latest.version}</strong><ArrowDown size={16} aria-hidden="true" /></a>
    </header>
    <div class="release-timeline" aria-label="Hyprism releases">
      {notes.map(({ release, html }, index) => (
        <article id={release.tag} class:list={['release-entry', { 'release-latest': index === 0 }]} data-reveal>
          <div class="release-marker"><span>{String(releases.length - index).padStart(2, '0')}</span></div>
          <div class="release-main">
            <header class="release-header">
              <div class="release-title-block">
                <p class="release-kicker">{index === 0 && <span class="current-release">Latest</span>}<span><Tag size={14} aria-hidden="true" /> {release.tag}</span></p>
                <h2>{release.title}</h2>
              </div>
              <div class="release-facts"><span><CalendarDays size={14} aria-hidden="true" /> {releaseDate(release.publishedAt)}</span><span><GitBranch size={14} aria-hidden="true" /> {release.version}</span></div>
            </header>
            <details class="release-details" open={index === 0}>
              <summary><span>Release notes</span><ChevronDown size={16} aria-hidden="true" /></summary>
              <div class="release-prose" set:html={html} />
            </details>
            <nav class="release-links" aria-label={`${release.tag} source links`}>
              <a href={release.url} target="_blank" rel="noreferrer">GitHub release <ArrowUpRight size={14} aria-hidden="true" /></a>
              <a href={release.tagUrl} target="_blank" rel="noreferrer">Source tag <ArrowUpRight size={14} aria-hidden="true" /></a>
            </nav>
          </div>
        </article>
      ))}
    </div>
    <p class="release-source-note">Release dates and notes are imported from GitHub Releases. To refresh the local archive, run <code>make website-releases-sync</code>.</p>
  </section>
  <script>
    if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.08 });
      document.querySelectorAll('[data-reveal]').forEach((element) => {
        element.classList.add('will-reveal');
        observer.observe(element);
      });
    }
  </script>
</Base>
